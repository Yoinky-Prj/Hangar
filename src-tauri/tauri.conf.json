{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangar",
  "version": "0.1.0",
  "identifier": "io.hangar.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hangar",
        "width": 1320,
        "height": 820,
        "minWidth": 960,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#15181e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Yoinky-Prj",
    "homepage": "https://github.com/Yoinky-Prj/Hangar",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Hangar",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
